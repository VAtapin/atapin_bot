# Copy to /etc/swpro-health/swpro-health.env on the server.
# Never commit the production file or Telegram secrets.

SWPRO_MONITOR_DOMAIN=swpro.ru
SWPRO_MONITOR_URL=https://swpro.ru/
SWPRO_SSL_WARN_DAYS=30
SWPRO_SSL_CRITICAL_DAYS=7
SWPRO_DISK_WARN_PERCENT=80
SWPRO_DISK_CRITICAL_PERCENT=90
SWPRO_INODE_WARN_PERCENT=80
SWPRO_INODE_CRITICAL_PERCENT=90
SWPRO_RAM_WARN_AVAILABLE_PERCENT=20
SWPRO_RAM_CRITICAL_AVAILABLE_PERCENT=10
SWPRO_SWAP_WARN_PERCENT=25
SWPRO_SWAP_CRITICAL_PERCENT=50
SWPRO_BACKUP_WARN_AGE_HOURS=26
SWPRO_BACKUP_CRITICAL_AGE_HOURS=50
SWPRO_HEALTH_INTERVAL_SECONDS=300
SWPRO_ALERT_COOLDOWN_SECONDS=1800
SWPRO_TELEGRAM_ADMIN_IDS=
SWPRO_TELEGRAM_BOT_TOKEN=
SWPRO_RESTIC_REPO=
SWPRO_RECOVERY_ENABLED=false
